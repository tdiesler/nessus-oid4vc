#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OID4VC="${SCRIPT_DIR}/oid4vc"
source "${SCRIPT_DIR}/oid4vc-functions"

VERBOSE=""
REALM="oid4vci"
for arg in "$@"; do
  case "${arg}" in
    --verbose) VERBOSE="--verbose" ;;
    *) REALM="${arg}" ;;
  esac
done

# Keycloak Admin Login
#
if ! is_refresh_token_still_valid; then
  KC_ADMIN_PASSWORD="$(kubectl --context=rancher-desktop get secret keycloak-secret -o jsonpath='{.data.ADMIN_PASSWORD}' | base64 -d)"
  ${OID4VC} ${VERBOSE} login --server http://localhost:30800 --password "${KC_ADMIN_PASSWORD}"
fi

# Delete OID4VCI Realm
#
${OID4VC} ${VERBOSE} realm delete "${REALM}" 2>/dev/null || true

# Create OID4VCI Realm
#
${OID4VC} ${VERBOSE} realm create "${REALM}"

# Create Realm Keys
#
${OID4VC} ${VERBOSE} key create --realm "${REALM}" --algo "ES256" --priority "120"
${OID4VC} ${VERBOSE} key create --realm "${REALM}" --algo "ECDH-ES" --priority "130"

# Create Airline Ticket Scope with GraphQL protocol mapper
#
${OID4VC} ${VERBOSE} scope create "oid4vc_airline_ticket_jwt" \
  --credential-type "AirlineTicketCredential" \
  --credential-description "Airline Ticket" \
  --graphql-claim-name "airline-ticket" \
  --graphql-endpoint "http://ticket:18080/graphql" \
  --graphql-query "query(\$id: String!) { booking(passengerId: \$id) { flightNumber route departureDateTime bookingReference passengerName } }" \
  --graphql-variable-mapping "id=username" \
  --graphql-response-path "booking"

# Create OID4VCI Client
#
${OID4VC} ${VERBOSE} client create "oid4vci-client" \
  --vc-scope "oid4vc_natural_person_sd" \
  --vc-scope "oid4vc_natural_person_jwt" \
  --vc-scope "oid4vc_airline_ticket_jwt"

# Create Users
#
${OID4VC} ${VERBOSE} user create "max" --first-name "Max" --last-name "Mustermann" --email "user@email.com" --password "password" --role "issuer"
${OID4VC} ${VERBOSE} user create "alice" --first-name "Alice" --last-name "Wonderland" --email "alice@email.com" --password "password" \
  --vc-scope "oid4vc_natural_person_sd" \
  --vc-scope "oid4vc_natural_person_jwt" \
  --vc-scope "oid4vc_airline_ticket_jwt"

# Holder Key
#
${OID4VC} ${VERBOSE} key create --user "alice" --algo "ES256"

# Holder Login & Credential (JWT)
#
scope="oid4vc_natural_person_jwt"
${OID4VC} ${VERBOSE} login --realm "${REALM}" --client-id "oid4vci-client" --user "alice" --password "password" --scope "${scope}"
vc_jwt=$(${OID4VC} ${VERBOSE} vc get --credential-id "${scope}_0000")
echo "Credential: ${vc_jwt}"
decode_vc "${vc_jwt}"

echo
echo "Realm setup complete: ${REALM}"

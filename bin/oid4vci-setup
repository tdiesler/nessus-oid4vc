#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OID4VP="${SCRIPT_DIR}/oid4vp"

VERBOSE=""
REALM="oid4vci"
for arg in "$@"; do
  case "${arg}" in
    --verbose) VERBOSE="--verbose" ;;
    *) REALM="${arg}" ;;
  esac
done

# The wallet stores three token-related values:
#
# - accessToken — short-lived token used for API calls. Keycloak default: 60 seconds.
# - refreshToken — longer-lived token used to get a new access token. Keycloak default: 30 minutes (SSO Session Idle).
# - expiresAt — we store this as Instant.now() + accessToken expires_in at login time. So expiresAt is typically ~60 seconds after login.
#
# The Java adminClient() handles this transparently: when expiresAt is approaching, it calls refreshAccessToken()
# using the refresh token to get a fresh access token — no password needed.
#
is_refresh_token_still_valid() {
  local wallet_file=".config/wallet.json"
  [[ -f "${wallet_file}" ]] || return 1
  local refresh_token
  refresh_token=$(python3 -c "import json; print(json.load(open('${wallet_file}'))['realms']['master']['users']['admin']['refreshToken'])" 2>/dev/null || true)
  [[ -n "${refresh_token}" ]] || return 1
  local expires_epoch now_epoch
  expires_epoch=$(python3 -c "import json, base64; payload = '${refresh_token}'.split('.')[1]; payload += '=' * (4 - len(payload) % 4); print(json.loads(base64.urlsafe_b64decode(payload))['exp'])" 2>/dev/null || echo 0)
  now_epoch=$(date +%s)
  (( expires_epoch > now_epoch ))
}

# Keycloak Admin Login
#
if ! is_refresh_token_still_valid; then
  KC_ADMIN_PASSWORD="$(kubectl --context=rancher-desktop get secret keycloak-secret -o jsonpath='{.data.ADMIN_PASSWORD}' | base64 -d)"
  ${OID4VP} ${VERBOSE} login --server http://localhost:30800 --password "${KC_ADMIN_PASSWORD}"
fi

# Delete OID4VCI Realm
#
${OID4VP} ${VERBOSE} realm delete "${REALM}" 2>/dev/null || true

# Create OID4VCI Realm
#
${OID4VP} ${VERBOSE} realm create "${REALM}"

# Create Realm Keys
#
${OID4VP} ${VERBOSE} key create --realm "${REALM}" --algo ES256 --priority 120
${OID4VP} ${VERBOSE} key create --realm "${REALM}" --algo ECDH-ES --priority 130

# Create OID4VCI Client
#
${OID4VP} ${VERBOSE} client create oid4vci-client

# Create Users
#
${OID4VP} ${VERBOSE} user create max --first-name Max --last-name Mustermann --email user@email.com --password password --role issuer
${OID4VP} ${VERBOSE} user create alice --first-name Alice --last-name Wonderland --email alice@email.com --password password

# Holder Login & Key
#
${OID4VP} ${VERBOSE} login --realm "${REALM}" --client-id oid4vci-client --user alice --password password --scope "oid4vc_natural_person_jwt"
${OID4VP} ${VERBOSE} key create --user alice --algo ES256

# Get Verifiable Credential
#
${OID4VP} ${VERBOSE} vc get --credential-id oid4vc_natural_person_jwt_0000

echo
echo "Realm setup complete: ${REALM}"

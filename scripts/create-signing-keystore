#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

SECRET_DIR="${SCRIPT_DIR}/../.secret"
mkdir -p "${SECRET_DIR}"
CA_P12="${SECRET_DIR}/ca.p12"
SIGNING_P12="${SECRET_DIR}/es256-vc-signing.p12"
SIGNING_ALIAS="es256-vc-signing"
CA_CERT="${SECRET_DIR}/ca.pem"
SIGNING_CSR="${SECRET_DIR}/signing.csr"
SIGNING_CERT="${SECRET_DIR}/signing.pem"
STORE_PASS="changeit"

if [[ -f "${SIGNING_P12}" ]]; then
  echo "Signing keystore already exists: ${SIGNING_P12}"
else
  echo "Generating CA key pair ..."
  keytool -genkeypair -alias ca -keyalg EC -groupname secp256r1 \
    -keystore "${CA_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -dname "CN=OID4VC Test CA" -ext bc=ca:true -ext ku=keyCertSign -validity 365

  echo "Generating signing key pair ..."
  keytool -genkeypair -alias "${SIGNING_ALIAS}" -keyalg EC -groupname secp256r1 \
    -keystore "${SIGNING_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -dname "CN=localhost" -ext ku=digitalSignature -validity 365

  echo "Signing with CA ..."
  keytool -certreq -alias "${SIGNING_ALIAS}" \
    -keystore "${SIGNING_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -file "${SIGNING_CSR}"
  keytool -gencert -alias ca \
    -keystore "${CA_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -infile "${SIGNING_CSR}" -outfile "${SIGNING_CERT}" \
    -ext ku=digitalSignature -validity 365 -rfc
  keytool -exportcert -alias ca \
    -keystore "${CA_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -file "${CA_CERT}" -rfc

  echo "Importing certificate chain ..."
  keytool -importcert -alias ca -noprompt \
    -keystore "${SIGNING_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -file "${CA_CERT}"
  keytool -importcert -alias "${SIGNING_ALIAS}" \
    -keystore "${SIGNING_P12}" -storetype PKCS12 -storepass "${STORE_PASS}" \
    -file "${SIGNING_CERT}"
fi

echo "Creating K8s secret 'signing-keystore' ..."
KUBE="kubectl --context=rancher-desktop"
${KUBE} delete secret signing-keystore >/dev/null 2>&1 || true
${KUBE} create secret generic signing-keystore \
  --from-file="${SIGNING_ALIAS}.p12=${SIGNING_P12}"

echo "Done. Deploy Keycloak with 'helm install' to mount the keystore."

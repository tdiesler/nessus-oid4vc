#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OID4VC="${SCRIPT_DIR}/../bin/oid4vc"
source "${SCRIPT_DIR}/oid4vc-functions"

VERBOSE=false
OID4VC_VERBOSE=""
REALM="oid4vci"
for arg in "$@"; do
  case "${arg}" in
    --verbose) VERBOSE=true; OID4VC_VERBOSE="--verbose" ;;
    *) REALM="${arg}" ;;
  esac
done

# Keycloak Admin Login (kcadm)
#
echo "Logging into Keycloak as admin ..."
KC_ADMIN_PASSWORD="$(kubectl --context=rancher-desktop get secret keycloak-secret -o jsonpath='{.data.ADMIN_PASSWORD}' | base64 -d)"
kcadm config credentials --server http://localhost:30800 --realm master --user admin --password "${KC_ADMIN_PASSWORD}" >/dev/null

# Delete OID4VCI Realm
#
echo "Deleting realm '${REALM}' ..."
kcadm delete "realms/${REALM}" >/dev/null 2>&1 || true

# Create OID4VCI Realm
#
echo "Creating realm '${REALM}' ..."
RESULT=$(kcadm create realms -o -s realm="${REALM}" \
  -s verifiableCredentialsEnabled="true" \
  -s enabled="true")
if ${VERBOSE}; then echo "${RESULT}"; fi

# Register CA-signed ES256 signing key (HAIP-6.1.1: certificate MUST NOT be self-signed)
# Prerequisite: run 'scripts/create-signing-keystore' and deploy with helm
#
echo "Registering ES256 signing key in realm '${REALM}' ..."
RESULT=$(kcadm create components -o -r "${REALM}" \
  -s name="es256-vc-signing" \
  -s providerId="java-keystore" \
  -s providerType="org.keycloak.keys.KeyProvider" \
  -s 'config.keyUse=["sig"]' \
  -s 'config.algorithm=["ES256"]' \
  -s 'config.keyPassword=["changeit"]' \
  -s 'config.storePassword=["changeit"]' \
  -s 'config.keystorePassword=["changeit"]' \
  -s 'config.keyAlias=["es256-vc-signing"]' \
  -s 'config.keystore=["es256-vc-signing.p12"]')
if ${VERBOSE}; then echo "${RESULT}"; fi

# Configure auto-created scopes to use ES256 (default is RS256)
#
for scope_name in oid4vc_natural_person_jwt oid4vc_natural_person_sd; do
  echo "Setting signing algorithm ES256 on scope '${scope_name}' ..."
  SCOPE_ID=$(kcadm get client-scopes -r "${REALM}" --fields id,name 2>/dev/null \
    | python3 -c "import json,sys
for s in json.load(sys.stdin):
    if s['name']=='${scope_name}': print(s['id'])")
  kcadm update "client-scopes/${SCOPE_ID}" -r "${REALM}" \
    -s 'attributes."vc.credential_signing_alg"=ES256'
done

echo "Creating ECDH-ES encryption key in realm '${REALM}' ..."
RESULT=$(kcadm create components -o -r "${REALM}" \
  -s name="ecdh-vc-encryption" \
  -s providerType="org.keycloak.keys.KeyProvider" \
  -s providerId="ecdh-generated")
if ${VERBOSE}; then echo "${RESULT}"; fi

create_vc_scope() {
  local scope_name="$1"
  local vc_format="$2"
  local vc_type="$3"
  local mapper_name="$4"
  local graphql_endpoint="$5"
  local graphql_query="$6"
  local response_path="$7"

  local sd_jwt_attrs=""
  if [[ "${vc_format}" == "dc+sd-jwt" ]]; then
    sd_jwt_attrs=',
      "vc.credential_build_config.hash_algorithm": "SHA-256",
      "vc.credential_build_config.token_jws_type": "dc+sd-jwt",
      "vc.credential_build_config.sd_jwt.visible_claims": "id,iat,nbf,exp,jti"'
  fi

  echo "Creating client scope '${scope_name}' ..."
  RESULT=$(kcadm create client-scopes -o -r "${REALM}" \
    -s name="${scope_name}" \
    -s protocol="oid4vc" \
    -s attributes="{
      \"vc.format\": \"${vc_format}\",
      \"vc.binding_required\": \"true\",
      \"vc.binding_required_proof_types\": \"jwt,attestation\",
      \"vc.cryptographic_binding_methods_supported\": \"jwk\",
      \"vc.credential_signing_alg\": \"ES256\",
      \"vc.verifiable_credential_type\": \"${vc_type}\"${sd_jwt_attrs}
    }" \
    -s protocolMappers="[
      {
        \"name\": \"subject-id\",
        \"protocol\": \"oid4vc\",
        \"protocolMapper\": \"oid4vc-subject-id-mapper\",
        \"config\": {
          \"claim.name\": \"id\",
          \"userAttribute\": \"username\"
        }
      },
      {
        \"name\": \"${mapper_name}\",
        \"protocol\": \"oid4vc\",
        \"protocolMapper\": \"oid4vc-graphql-claim-mapper\",
        \"config\": {
          \"claim.name\": \"${mapper_name}\",
          \"graphqlEndpoint\": \"${graphql_endpoint}\",
          \"graphqlQuery\": \"${graphql_query}\",
          \"graphqlVariableMapping\": \"id=username\",
          \"responsePath\": \"${response_path}\"
        }
      }
    ]")
  if ${VERBOSE}; then echo "${RESULT}"; fi
}

TICKET_QUERY='query($id: String!) { booking(passengerId: $id) { flightNumber route departureDateTime bookingReference passengerName } }'
BOARDING_QUERY='query($id: String!) { boardingPass(passengerId: $id) { passengerName flightNumber seat boardingGroup departureDateTime gate } }'

# Create Airline Ticket + Boarding Pass Scopes (SD-JWT + JWT)
#
create_vc_scope "oid4vc_airline_ticket_jwt" "jwt_vc_json"  "AirlineTicketCredential"  "airline-ticket" "http://ticket:18080/graphql"  "${TICKET_QUERY}"   "booking"
create_vc_scope "oid4vc_airline_ticket_sd"  "dc+sd-jwt"   "AirlineTicketCredential"  "airline-ticket" "http://ticket:18080/graphql"  "${TICKET_QUERY}"   "booking"
create_vc_scope "oid4vc_boarding_pass_jwt"  "jwt_vc_json"  "BoardingPassCredential"   "boarding-pass"  "http://checkin:18090/graphql" "${BOARDING_QUERY}"  "boardingPass"
create_vc_scope "oid4vc_boarding_pass_sd"   "dc+sd-jwt"    "BoardingPassCredential"   "boarding-pass"  "http://checkin:18090/graphql" "${BOARDING_QUERY}"  "boardingPass"

# Create OID4VCI Client
#
echo "Creating client 'oid4vci-client' ..."
RESULT=$(kcadm create clients -o -r "${REALM}" \
  -s name="OID4VCI Client" \
  -s clientId="oid4vci-client" \
  -s publicClient="true" \
  -s directAccessGrantsEnabled="true" \
  -s redirectUris='[
    "urn:ietf:wg:oauth:2.0:oob",
    "http://localhost:18888/callback",
    "https://oauth.pstmn.io/v1/callback"
    ]' \
  -s optionalClientScopes='[
    "profile",
    "oid4vc_natural_person_sd",
    "oid4vc_natural_person_jwt",
    "oid4vc_airline_ticket_sd",
    "oid4vc_airline_ticket_jwt",
    "oid4vc_boarding_pass_sd",
    "oid4vc_boarding_pass_jwt"
    ]' \
  -s attributes='{"oid4vci.enabled":"true"}')
if ${VERBOSE}; then echo "${RESULT}"; fi

# Create Users
#
echo "Creating user 'max' ..."
RESULT=$(kcadm create users -i -r "${REALM}" \
  -s username="max" \
  -s firstName="Max" \
  -s lastName="Mustermann" \
  -s email="user@email.com" \
  -s emailVerified="true" \
  -s enabled="true" \
  -s credentials='[{"type":"password","value":"password","temporary":false}]')
MAX_ID="${RESULT}"

echo "Assigning role 'credential-offer-create' to user 'max' ..."
kcadm add-roles -r "${REALM}" --uusername "max" --rolename "credential-offer-create"

echo "Creating user 'alice' ..."
RESULT=$(kcadm create users -i -r "${REALM}" \
  -s username="alice" \
  -s firstName="Alice" \
  -s lastName="Wonderland" \
  -s email="alice@email.com" \
  -s emailVerified="true" \
  -s enabled="true" \
  -s credentials='[{"type":"password","value":"password","temporary":false}]')
ALICE_ID="${RESULT}"

for scope in oid4vc_natural_person_sd oid4vc_natural_person_jwt oid4vc_airline_ticket_sd oid4vc_airline_ticket_jwt oid4vc_boarding_pass_sd oid4vc_boarding_pass_jwt; do
  echo "Assigning VC scope '${scope}' to user 'alice' ..."
  kcadm create "users/${ALICE_ID}/vc/credentials" -r "${REALM}" \
    -s "credentialScopeName=${scope}"
done

# Configure wallet defaults
#
rm -f .config/wallet.json
${OID4VC} ${OID4VC_VERBOSE} config --server "http://localhost:30800" --realm "${REALM}" --client "oid4vci-client"

# Holder Key
#
${OID4VC} ${OID4VC_VERBOSE} key create --user "alice" --algo "ES256"

# Holder Login & Credential
#
for scope in "oid4vc_natural_person_jwt" "oid4vc_natural_person_sd"; do
  ${OID4VC} ${OID4VC_VERBOSE} login --realm "${REALM}" --client "oid4vci-client" --user "alice" --password "password" --scope "${scope}"
  vc_jwt=$(${OID4VC} ${OID4VC_VERBOSE} vc get --credential-id "${scope}_0000")
  echo "Credential: ${vc_jwt}"
  decode_vc "${vc_jwt}"
done

echo "Realm setup complete"

#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OID4VC="${SCRIPT_DIR}/../bin/oid4vc"
source "${SCRIPT_DIR}/oid4vc-functions"

EXTERNAL_IP="${EXTERNAL_IP:-localhost}"

if [[ "${1:-}" == "--restart" ]]; then
  local wf=".config/wallet.json"
  if [[ -f "${wf}" ]]; then
    jq '.realms[]?.users[]? |= del(.credentials, .offerUris, .offers, .authorizationDetails, .accessToken, .refreshToken, .expiresAt)' \
      "${wf}" > "${wf}.tmp" && mv "${wf}.tmp" "${wf}"
    echo "Wallet reset (offers, credentials, tokens; keys preserved)"
  fi

  curl -sf -X DELETE "http://${EXTERNAL_IP}:30100/api/bookings" > /dev/null 2>&1
  curl -sf -X DELETE "http://${EXTERNAL_IP}:30200/api/passes" > /dev/null 2>&1
  echo "Tickets and Boarding passes cleared"

  shift
fi

REALM="${1:-oid4vci}"
VC_FMT="jwt"
next="1"

# Menu Actions ---------------------------------------------------------------------------------------------------------

do_booking() {
  local scope="oid4vc_airline_ticket_${VC_FMT}"

  echo
  echo "  Step 1/4: Create an airline ticket booking"
  echo
  local cmd="oid4vc demo booking --passenger-name \"Alice Wonderland\" --flight \"BA123\" --route \"LHR-JFK\" --departure \"2026-10-15T08:30:00Z\""
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  local booking_json
  booking_json=$(eval "${expanded}") || return 1

  local claims_ref=$(echo "${booking_json}" | jq -r '.ticketRef')
  echo "  Ticket Ref: ${claims_ref}"
  open "http://${EXTERNAL_IP}:30100/bookings.html"

  echo
  echo "  Step 2/4: Issuer creates a pre-auth credential offer"
  _run_headless ${OID4VC} login \
    --realm "${REALM}" --user "iss" --password "password"
  _run_editable ${OID4VC} offer create \
    --user "iss" \
    --target-user "airline" \
    --store-for "alice" \
    --credential-configuration "${scope}" \
    --claims-ref "${claims_ref}" \
    --type=uri_qr \
    --pre-auth=true

  echo
  echo "  Step 3/4: Alice fetches the offer"
  _run_editable ${OID4VC} offer get "${scope}"

  echo
  echo "  Step 4/4: Alice redeems the Airline Ticket offer"
  _redeem_offer "${scope}" "Airline Ticket"
}

do_checkin() {
  local scope="oid4vc_boarding_pass_${VC_FMT}"

  echo
  echo "  Step 1/4: Present Airline Ticket + Passport to the check-in verifier"
  echo
  local cmd="oid4vc vc present --verifier \"http://${EXTERNAL_IP}:30200/checkin\""
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  local checkin_json
  checkin_json=$(eval "${expanded}") || return 1

  local claims_ref=$(echo "${checkin_json}" | jq -r '.boardingPass.boardingRef // empty')
  if [[ -z "${claims_ref}" ]]; then
    echo "  Check-in failed:"
    echo "${checkin_json}" | jq . 2>/dev/null || echo "  ${checkin_json}"
    return 1
  fi
  echo "  Check-in approved, Boarding Ref: ${claims_ref}"
  open "http://${EXTERNAL_IP}:30200/passes.html"

  echo
  echo "  Step 2/4: Issuer creates a pre-auth boarding pass offer"
  _run_headless ${OID4VC} login \
    --realm "${REALM}" --user "iss" --password "password"
  _run_editable ${OID4VC} offer create \
    --user "iss" \
    --target-user "checkin" \
    --store-for "alice" \
    --credential-configuration "${scope}" \
    --claims-ref "${claims_ref}" \
    --type=uri_qr \
    --pre-auth=true

  echo
  echo "  Step 3/4: Alice fetches the offer"
  _run_editable ${OID4VC} offer get "${scope}"

  echo
  echo "  Step 4/4: Alice redeems the Boarding Pass offer"
  _redeem_offer "${scope}" "Boarding Pass"
}

do_gate() {
  echo
  echo "  Present Boarding Pass + Passport to the gate verifier"
  _run_editable ${OID4VC} vc present \
    --verifier "http://${EXTERNAL_IP}:30300/gate"
}

do_passport() {
  local scope="oid4vc_natural_person_${VC_FMT}"

  echo
  echo "  Step 1/4: Issuer creates an auth-code grant credential offer for Alice"
  _run_headless ${OID4VC} login \
    --realm "${REALM}" --user "iss" --password "password"
  _run_editable ${OID4VC} offer create \
    --user "iss" \
    --target-user "alice" \
    --credential-configuration "${scope}" \
    --type=uri_qr \
    --pre-auth=false

  echo
  echo "  Step 2/4: Alice fetches the offer"
  _run_editable ${OID4VC} offer get "${scope}"

  echo
  echo "  Step 3/4: Alice logs in to authorize"
  _run_editable ${OID4VC} login \
    --user "alice" \
    --scope "${scope}" \
    --browser

  echo
  echo "  Step 4/4: Alice redeems the offer"
  _redeem_offer "${scope}" "Passport"
}

do_show_offer() {
  echo
  echo "  Show stored credential offers"
  _run_headless ${OID4VC} show offer
}

do_show_vc() {
  echo
  echo "  Show stored verifiable credentials"
  _run_headless ${OID4VC} show vc
}

main() {
  while true; do
    echo
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    local vc_fmt_label="jwt_vc_json"
    if [[ "${VC_FMT}" == "sd" ]]; then vc_fmt_label="dc+sd-jwt"; fi
    echo "  OID4VC Airport Demo              [${vc_fmt_label}]"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
    echo "  o - Show credential offers"
    echo "  c - Show verifiable credentials"
    echo "  f - Switch VC format (jwt/sd)"
    echo "  1 - Get a passport credential"
    echo "  2 - Book a flight and get the airline ticket"
    echo "  3 - Check in and get the boarding pass"
    echo "  4 - Board at the gate (verify boarding pass + passport)"
    echo "  q - Quit"
    echo
    read -r "choice?  Choose an option [${next}]: "
    choice="${choice:-${next}}"

    case "${choice}" in
      c) do_show_vc ;;
      o) do_show_offer ;;
      f) if [[ "${VC_FMT}" == "jwt" ]]; then VC_FMT="sd"; else VC_FMT="jwt"; fi ;;
      1) do_passport; next="2" ;;
      2) do_booking; next="3" ;;
      3) do_checkin; next="4" ;;
      4) do_gate; next="q" ;;
      q) echo; echo "  Bye."; break ;;
      *) echo "  Invalid option." ;;
    esac
  done
}

# Internal -------------------------------------------------------------------------------------------------------------

_get_tx_code() {
  local scope="$1"
  local wf=".config/wallet.json"
  if [[ -f "${wf}" ]]; then
    jq -r --arg scope "${scope}" '
      .realms[].users[].offerUris[$scope].txCode // empty
    ' "${wf}" 2>/dev/null | head -1
  fi
}

_format_cmd() {
  local display="" prev_was_option=false
  for arg in "$@"; do
    if [[ "${arg}" == "${OID4VC}" ]]; then
      display+="oid4vc "
      prev_was_option=false
    elif [[ "${arg}" == --* ]]; then
      display+="${arg} "
      prev_was_option=true
    elif ${prev_was_option}; then
      display+="\"${arg}\" "
      prev_was_option=false
    else
      display+="${arg} "
      prev_was_option=false
    fi
  done
  echo "${display% }"
}

_get_vc() {
  local scope="$1"
  local label="$2"

  echo
  echo "  Step 1/2: Login as Alice with scope ${scope}"
  _run_editable ${OID4VC} login \
    --browser \
    --user "alice" \
    --scope "${scope}"

  echo
  echo "  Step 2/2: Request the ${label}"
  echo
  local cmd="oid4vc vc get --credential-identifier \"${scope}_0000\""
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  vc_jwt=$(eval "${expanded}")
  echo
  echo "  Decoded Verifiable Credential:"
  echo
  decode_vc "${vc_jwt}"
}

_redeem_offer() {
  local scope="$1"
  local label="$2"

  local tx_code=$(_get_tx_code "${scope}")
  local tx_code_opt=""
  if [[ -n "${tx_code}" ]]; then
    tx_code_opt=" --tx-code ${tx_code}"
  fi

  echo
  echo "  Redeem the ${label} offer"
  echo
  local cmd="oid4vc offer redeem ${scope}${tx_code_opt}"
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  vc_jwt=$(eval "${expanded}")
  echo
  echo "  Decoded Verifiable Credential:"
  echo
  decode_vc "${vc_jwt}"
}

_run_editable() {
  local cmd="$(_format_cmd "$@")"

  echo
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  eval "${expanded}"
}

_run_headless() {
  echo
  echo "  \$ $(_format_cmd "$@")"
  echo
  "$@"
}

main
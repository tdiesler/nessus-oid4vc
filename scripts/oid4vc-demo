#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OID4VC="${SCRIPT_DIR}/../bin/oid4vc"
source "${SCRIPT_DIR}/oid4vc-functions"

REALM="${1:-oid4vci}"

format_cmd() {
  local display="" prev_was_option=false
  for arg in "$@"; do
    if [[ "${arg}" == "${OID4VC}" ]]; then
      display+="oid4vc "
      prev_was_option=false
    elif [[ "${arg}" == --* ]]; then
      display+="${arg} "
      prev_was_option=true
    elif ${prev_was_option}; then
      display+="\"${arg}\" "
      prev_was_option=false
    else
      display+="${arg} "
      prev_was_option=false
    fi
  done
  echo "${display% }"
}

run_headless() {
  echo
  echo "  \$ $(format_cmd "$@")"
  echo
  "$@"
}

run_editable() {
  local cmd="$(format_cmd "$@")"

  echo
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  eval "${expanded}"
}

get_vc() {
  local scope="$1"
  local label="$2"

  echo
  echo "  Step 1/2: Login as Alice with scope ${scope}"
  run_editable ${OID4VC} login \
    --browser \
    --user "alice" \
    --scope "${scope}"

  echo
  echo "  Step 2/2: Request the ${label}"
  echo
  local cmd="oid4vc vc get --credential-id \"${scope}_0000\""
  vared -p "  \$ " cmd
  echo

  local expanded="${cmd/#oid4vc /${OID4VC} }"
  vc_jwt=$(eval "${expanded}")
  echo
  echo "  Decoded Verifiable Credential:"
  echo
  decode_vc "${vc_jwt}"
}

do_passport() {
  get_vc "oid4vc_natural_person_jwt" "Passport Credential"
}

do_booking() {
  echo
  echo "  Create an airline ticket booking for passenger Alice"
  run_editable ${OID4VC} demo booking \
    --passenger-id "alice" \
    --passenger-name "Alice Wonderland" \
    --flight "BA123" \
    --route "LHR-JFK" \
    --departure "2026-10-15T08:30:00Z"
}

do_ticket() {
  get_vc "oid4vc_airline_ticket_jwt" "Airline Ticket Credential"
}

do_checkin() {
  echo
  echo "  Present Airline Ticket + Passport to the check-in verifier"
  run_editable ${OID4VC} vc present \
    --verifier "http://localhost:30200/checkin"
}

do_boarding_pass() {
  get_vc "oid4vc_boarding_pass_jwt" "Boarding Pass Credential"
}

do_gate() {
  echo
  echo "  Present Boarding Pass + Passport to the gate verifier"
  run_editable ${OID4VC} vc present \
    --verifier "http://localhost:30300/gate"
}

do_show_vc() {
  echo
  echo "  Show stored verifiable credentials"
  run_editable ${OID4VC} show vc
}

next="0"

while true; do
  echo
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  OID4VC Airport Demo"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo
  echo "  0 - Show verifiable credentials"
  echo "  1 - Get a passport credential"
  echo "  2 - Make an airline booking"
  echo "  3 - Get the airline ticket credential"
  echo "  4 - Check in (verify ticket + passport)"
  echo "  5 - Get the boarding pass credential"
  echo "  6 - Board at the gate (verify boarding pass + passport)"
  echo "  q - Quit"
  echo
  read -r "choice?  Choose an option [${next}]: "
  choice="${choice:-${next}}"

  case "${choice}" in
    0) do_show_vc; next="1" ;;
    1) do_passport; next="2" ;;
    2) do_booking; next="3" ;;
    3) do_ticket; next="4" ;;
    4) do_checkin; next="5" ;;
    5) do_boarding_pass; next="6" ;;
    6) do_gate; next="q" ;;
    q|Q) echo; echo "  Bye."; break ;;
    *) echo "  Invalid option." ;;
  esac
done
